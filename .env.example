# Copy to .env before starting containers. Never commit the populated file.
POSTGRES_DB=familyquest
POSTGRES_USER=familyquest
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL=12h
# Containers reach PostgreSQL by its Compose service name, not localhost.
DATABASE_URL=postgres://familyquest:replace-with-a-long-random-password@postgres:5432/familyquest?sslmode=disable
HTTP_ADDR=:8081
CORS_ORIGIN=http://localhost:8088
POSTGRES_PORT=5433
API_PORT=8081
WEB_PORT=8088
# Production only (docker-compose.prod.yml)
PUBLIC_HOST=familyquest.example.com
TRAEFIK_NETWORK=homelab
